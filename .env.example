# Copy to .env and customize for development
PORT=3000
SESSION_SECRET=replace-me-with-a-secret
SESSION_NAME=su_sid
NODE_ENV=development
SQLITE_PATH=./data/dev.db
# Optional: When deploying to Neon/Vercel set DATABASE_URL in your project env.
# Example: postgres://user:pass@host:port/dbname  (the config will convert this to postgresql://)
DATABASE_URL=
